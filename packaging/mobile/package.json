{
  "name": "padel-on-mobile-wrapper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:web": "node ../../scripts/prepare-native-web.mjs",
    "add:android": "npm run prepare:web && cap add android && cap sync android && npm run branding:android",
    "add:ios": "npm run prepare:web && cap add ios && cap sync ios && npm run branding:ios",
    "sync:android": "npm run prepare:web && cap sync android && npm run branding:android",
    "sync:ios": "npm run prepare:web && cap sync ios && npm run branding:ios",
    "branding:prepare": "node ../../scripts/prepare-mobile-branding.mjs",
    "branding:android": "npm run branding:prepare && capacitor-assets generate --android --iconBackgroundColor \"#0b1715\" --iconBackgroundColorDark \"#0b1715\" --splashBackgroundColor \"#0b1715\" --splashBackgroundColorDark \"#0b1715\"",
    "branding:ios": "npm run branding:prepare && capacitor-assets generate --ios --iconBackgroundColor \"#0b1715\" --iconBackgroundColorDark \"#0b1715\" --splashBackgroundColor \"#0b1715\" --splashBackgroundColorDark \"#0b1715\""
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/assets": "3.0.5"
  }
}
