{
  "name": "padel-on-windows",
  "version": "1.0.0",
  "private": true,
  "main": "main.cjs",
  "description": "Padel On desktop client, connecting securely to the existing managed website",
  "scripts": {
    "start": "electron .",
    "build:exe": "npm run branding:windows && electron-builder --win portable --x64 --publish never",
    "branding:windows": "node generate-icon.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.padelon.management",
    "productName": "Padel On",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PadelOn-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico",
      "signExecutable": false
    }
  }
}
